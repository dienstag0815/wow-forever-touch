<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer: nothing of this app leaves the device, neither into a cloud backup nor by device-to-device transfer.
  What lives in the app storage must stay on this one installation: the saved Battle.net sign-in (e-mail, sealed password),
  the own Windows machine identity (wow_identity.properties) and the Wine prefix with its registry. A copy on a second
  device would make two devices look like the same PC to Blizzard. allowBackup="false" in the manifest says the same;
  this file keeps it that way even if that attribute is ever changed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
